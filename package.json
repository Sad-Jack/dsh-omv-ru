{
  "name": "dsh-omv",
  "version": "1.0.7-local.1.ru.3",
  "description": "Находки, доказательства, проверка гипотез и подготовка отчётов.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/",
    "contracts/",
    "ARCHITECTURE.md",
    "DSH-INTEGRATION.md",
    "omv-audit-desk-overview.png",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "locale",
    "README*.md",
    "UPSTREAM.md",
    "LOCALIZATION.md",
    "LICENSE*",
    "publication.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "oh-my-vul": "^1.1.0",
    "simple-icons": "^16.28.0",
    "yaml": "^2.8.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6 || ^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6 || ^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6 || ^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6 || ^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.6 || ^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-tool": "^0.1.0-rc.6 || ^0.2.1-rc.5",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6 || ^0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6 || ^0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6 || ^0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6 || ^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.1-rc.5",
    "@deepseek-ai/dsh-workspace": "^0.1.0-rc.6 || ^0.2.1-rc.5",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-tool": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "security-audit",
    "vulnerability-research",
    "oh-my-vul"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sad-Jack/dsh-omv-ru.git"
  },
  "homepage": "https://github.com/Sad-Jack/dsh-omv-ru#readme",
  "bugs": {
    "url": "https://github.com/Sad-Jack/dsh-omv-ru/issues"
  }
}
